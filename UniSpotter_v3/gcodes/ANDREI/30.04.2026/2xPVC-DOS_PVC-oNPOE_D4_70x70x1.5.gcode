
G90 ;use absolute coordinates
G21 ;unit mm

;Homing sequence
M117 Gantry Align
G28 Z0 ;Home Z
G28 Y0 ;Home Y
G0 Z35 F5000.0;Move to X Homing position
G28 X0 ;Home X
G0 X75.0 Y70.0 F5000.0 ; Go with Head to probe position
SET_TMC_FIELD STEPPER=stepper_z FIELD=SGT VALUE=0
G0 Z110.0 F300.0 ; Ram into top
G0 Z105.0 F300.0 ; Back down
SET_TMC_FIELD STEPPER=stepper_z FIELD=SGT VALUE=4
G28 Z0; Home Z again
G28 Z0; Home Z again
M117 Aligned
MESH X_MIN=30.000 X_MAX=190.000 Y_MIN=29.500 Y_MAX=184.500 POINTS=5 ;Home Z with mesh bed leveling inside acceptance square
G0 X75.0 Y70.0 F5000.0; Go with probe above vacuum chuck
HOME_SYRINGE
DISPENSE MM=0
G1 Z0.0 F300.0 
M117 ;Calibrate Needle to touch substrate
PAUSE
G0 Z40.0 F5000.0
G0 Z40.0 F5000.0



; Dynamic refill target: 40.000 mm (8.000 uL);remaining=0.000 mm required=0.000 mm
G0 X116.0 Y208.0 F5000.0
G0 Z-17.0  F3000.0
ASPIRATE MM=50.0 SPEED=1.0; Filling the syringe
WAIT S=10.0
DISPENSE MM=10.0 SPEED=15.0 RELATIVE=1; Prevent backlash the syringe
WAIT S=2.0
G0 Z40.0 F5000.0

; Washing sequence
G0 Z40.0 F5000
