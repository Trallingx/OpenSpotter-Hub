
G90 ;use absolute coordinates
G21 ;unit mm

;Homing sequence
M117 Gantry Align
G28 Z0 ;Home Z
G28 X0 Y0 ;Home X Y
G0 X75.0 Y70.0 F5000.0 ; Go with Head to probe position
SET_TMC_FIELD STEPPER=stepper_z FIELD=SGT VALUE=0
G0 Z110.0 F300.0 ; Ram into top
G0 Z105.0 F300.0 ; Back down
SET_TMC_FIELD STEPPER=stepper_z FIELD=SGT VALUE=4
G28 Z0; Home Z again
G28 Z0; Home Z again
M117 Aligned
MESH X_MIN=27.000 X_MAX=187.000 Y_MIN=30.000 Y_MAX=190.000 POINTS=3 ;Home Z with mesh bed leveling inside acceptance square
G0 X75.0 Y70.0 F5000.0; Go with probe above vacuum chuck
HOME_SYRINGE
DISPENSE MM=0
G1 Z0.0 F300.0 
M117 ;Calibrate Needle to touch substrate
PAUSE
G0 Z40.0 F5000.0
G0 Z40.0 F5000.0
G0 X217.0 Y66.0 F5000.0
G0 Z-6.0  F3000.0
ASPIRATE MM=15.0 SPEED=2.0; Filling the syringe
WAIT S=2.0
DISPENSE MM=5.0 SPEED=15.0 RELATIVE=1; Prevent backlash the syringe
WAIT S=2.0
G0 Z40.0 F5000.0


; Create cleaning sequence
G0 X59.0 Y72.0 F5000
WAIT S=0.2
DISPENSE MM=0.25 SPEED=500 RELATIVE=1
G0 Z0.15 F500 ;position for liquid contact
G0 Z1.0 F5000
